 config.example.js                   | 3 +++
 coordinacion/app.js                 | 6 +++++-
 coordinacion/concilia-integrated.js | 4 +++-
 coordinacion/modules/supabase.js    | 6 +++++-
 curriculos/app.js                   | 4 +++-
 programacion/app.js                 | 6 +++++-
 shared/supabase-client.js           | 8 +++++++-
 8 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/concilia/app.js b/concilia/app.js
index af93f47..7113f7b 100644
--- a/concilia/app.js
+++ b/concilia/app.js
@@ -6243,7 +6243,9 @@
     }
 
     const { createClient } = await import("https://esm.sh/@supabase/supabase-js@2");
-    const client = createClient(supabaseConfig.url, supabaseConfig.anonKey);
+    const client = createClient(supabaseConfig.url, supabaseConfig.anonKey, {
+      db: { schema: supabaseConfig.schema ?? "public" },
+    });
     client.auth.onAuthStateChange((_event, session) => {
       window.SupabaseApp?.setSession(session);
     });
